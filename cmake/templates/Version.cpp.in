#include "ate_parser/version.hpp"

namespace ate::version {

namespace {
const std::string g_full     = "@PROJECT_VERSION_FULL@";
const std::string g_git_hash = "@GIT_HASH@";
}

std::string full()     { return g_full; }
std::string git_hash() { return g_git_hash; }

}

extern "C" {
    const char* ate_version_full()     { return ate::version::full().c_str(); }
    const char* ate_version_git_hash() { return ate::version::git_hash().c_str(); }
}